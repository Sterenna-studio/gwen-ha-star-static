# ═══════════════════════════════════════════════════════════════
#  .htaccess — Gwen Ha Star Static
#  Cache-Control intelligent (CORS géré par Cloudflare)
# ═══════════════════════════════════════════════════════════════

Options -Indexes

# ── ZONE ADMIN : Basic Auth (défense en profondeur, en + du rôle superuser Supabase) ──
<FilesMatch "^admin-dashboard\.(html|js)$">
  AuthType Basic
  AuthName "Gwen Ha Star — Zone admin"
  AuthUserFile /homez.956/sterenn/.htpasswd-admin
  Require valid-user
</FilesMatch>

# ── CACHE CONTROL ──────────────────────────────────────────────
<IfModule mod_headers.c>

  # HTML → jamais en cache — Cloudflare revalide toujours (plus de purge manuelle)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # JSON dynamiques → revalidation pour radio live, jukebox et manifests applicatifs
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # CSS / JS → 1 an immutable (cache busting via ?v= ou renommage)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images / Fonts → 7 jours
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

</IfModule>

# ── COMPRESSION GZIP ────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ── MIME TYPES ──────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css               .css
  AddType font/woff2             .woff2
  AddType font/woff              .woff
  AddType application/json       .json
</IfModule>
