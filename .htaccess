# ═══════════════════════════════════════════════════════════════
#  .htaccess — Gwen Ha Star Static
#  Cache-Control, MIME, gzip et headers de sécurité légers
# ═══════════════════════════════════════════════════════════════

Options -Indexes

# ── CHRONICLES FM : source playlist canonique WEB RADIO · YOUTUBE ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^chronicles-fm/data\.json$ /jukebox/chronicles-fm.json [R=302,L]

  # Runtime Korigan: keep stable same-origin Nitro URLs for static widgets.
  RewriteRule ^api/korigan/chat/state$ https://korigan.sterenna.fr/api/korigan/chat/state [R=302,L,NE]
  RewriteRule ^api/korigan/bots/status$ https://korigan.sterenna.fr/api/korigan/bots/status [R=302,L,NE]
  RewriteRule ^api/korigan/radio/state$ https://korigan.sterenna.fr/api/korigan/radio/state [R=302,L,NE]
  RewriteRule ^minitel/(.*)$ https://korigan.sterenna.fr/minitel/$1 [R=302,L,NE]
  RewriteRule ^radio/chronicles\.mp3$ https://korigan.sterenna.fr/radio/chronicles.mp3 [R=302,L,NE]
</IfModule>

# ── ZONE ADMIN : Basic Auth (défense en profondeur, en + du rôle superuser Supabase) ──
<FilesMatch "^admin-(dashboard|audio)\.(html|js)$">
  AuthType Basic
  AuthName "Gwen Ha Star — Zone admin"
  AuthUserFile /homez.956/sterenn/.htpasswd-admin
  Require valid-user
</FilesMatch>

# ── AUDIO : pas de listing, MIME mp3/ogg/wav, cache 7j ──────────
<IfModule mod_mime.c>
  AddType audio/mpeg       .mp3
  AddType audio/ogg        .ogg
  AddType audio/wav        .wav
</IfModule>

<FilesMatch "\.(mp3|ogg|wav)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
    Header set Accept-Ranges "bytes"
  </IfModule>
</FilesMatch>

# ── HEADERS HTTP ───────────────────────────────────────────────
<IfModule mod_headers.c>

  # Sécurité légère et compatible avec les embeds Twitch / YouTube / Supabase.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # CSP volontairement en Report-Only pour ne pas casser les CDN/embeds en production.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://*.supabase.co https://www.youtube.com https://player.twitch.tv; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https://nitro.sterenna.fr; connect-src 'self' https://*.supabase.co https://esm.sh; frame-src https://www.youtube.com https://player.twitch.tv; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # HTML → jamais en cache — Cloudflare revalide toujours (plus de purge manuelle)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # JSON dynamiques → revalidation pour radio live, jukebox et manifests applicatifs
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # CSS / JS → revalidation obligatoire tant que les fichiers ne sont pas tous versionnés.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Images / Fonts → 7 jours
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

</IfModule>

# ── COMPRESSION GZIP ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ── MIME TYPES ─────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css               .css
  AddType font/woff2             .woff2
  AddType font/woff              .woff
</IfModule>
