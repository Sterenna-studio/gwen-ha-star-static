# ═══════════════════════════════════════════════════════════════
#  .htaccess — Gwen Ha Star Static
#  Cache-Control intelligent (CORS géré par Cloudflare)
# ═══════════════════════════════════════════════════════════════

Options -Indexes

# ── CHRONICLES FM : source playlist canonique WEB RADIO · YOUTUBE ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^chronicles-fm/data\.json$ /jukebox/chronicles-fm.json [R=302,L]
</IfModule>

# ── ZONE ADMIN : Basic Auth (défense en profondeur, en + du rôle superuser Supabase) ──
<FilesMatch "^admin-(dashboard|audio)\.(html|js)$">
  AuthType Basic
  AuthName "Gwen Ha Star — Zone admin"
  AuthUserFile /homez.956/sterenn/.htpasswd-admin
  Require valid-user
</FilesMatch>

# ── AUDIO : pas de listing, MIME mp3/ogg/wav, cache 7j ──────────
<IfModule mod_mime.c>
  AddType audio/mpeg       .mp3
  AddType audio/ogg        .ogg
  AddType audio/wav        .wav
</IfModule>

<FilesMatch "\.(mp3|ogg|wav)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
    Header set Accept-Ranges "bytes"
  </IfModule>
</FilesMatch>

# ── CACHE CONTROL ──────────────────────────────────────────────
<IfModule mod_headers.c>

  # HTML → jamais en cache — Cloudflare revalide toujours (plus de purge manuelle)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # JSON dynamiques → revalidation pour radio live, jukebox et manifests applicatifs
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # CSS / JS → revalidation obligatoire tant que les fichiers ne sont pas tous versionnés.
  # Évite de servir un ancien widget Chronicles FM encore en cache avec l'appel YouTube Data API.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Images / Fonts → 7 jours
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

</IfModule>

# ── PATCHS HTML LÉGERS ──────────────────────────────────────
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  # Accueil public : layout simplifié Twitch+YouTube puis Web Radio.
  Substitute "s|</head>|<link rel=\"stylesheet\" href=\"/css/home-sections.css?v=20260702\"></head>|n"
  # Radio live Star : stabilizer runtime non destructif.
  Substitute "s|<script type=\"module\">|<script type=\"module\" src=\"/js/star/radio-player-stabilizer.js\"></script>\n  <script type=\"module\">|n"
</IfModule>

# ── COMPRESSION GZIP ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ── MIME TYPES ─────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css               .css
  AddType font/woff2             .woff2
  AddType font/woff              .woff
</IfModule>
